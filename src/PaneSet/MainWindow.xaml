<Window x:Class="PaneSet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PaneSet" Title="PaneSet · 窗口组"
        Width="820" Height="730" MinWidth="600" MinHeight="600" WindowStartupLocation="Manual"
        Background="#F4F5F1" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#202B26"/>
    <SolidColorBrush x:Key="Muted" Color="#55665D"/>
    <SolidColorBrush x:Key="Accent" Color="#27664E"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="40"/>
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      <Setter Property="BorderBrush" Value="#CDD4CD"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.86"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.7"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#27664E"/><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Row" Background="White" BorderBrush="#E0E5DE" BorderThickness="0,0,0,1" Padding="12,10">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Marker" Width="26" Height="26" CornerRadius="6" Background="#EFF2EC" BorderBrush="#CAD2C8" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock x:Name="Number" Text="{Binding OrderText}" Foreground="#55665D" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Border>
            <ContentPresenter Grid.Column="1"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Row" Property="Background" Value="#EAF1E8"/><Setter TargetName="Marker" Property="Background" Value="#27664E"/><Setter TargetName="Number" Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Opacity" Value="0.88"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#27664E"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="PaneSet" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="从各屏幕选窗，集中排布。" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
      </StackPanel>
      <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新窗口" Click="RefreshClick" VerticalAlignment="Center" AutomationProperties.Name="刷新窗口"/>
    </Grid>
    <Grid x:Name="BodyGrid" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
          <TextBox x:Name="SearchBox" MinHeight="40" Padding="12,8" Background="White" BorderBrush="#CAD2C8"
                   TextChanged="SearchChanged" AutomationProperties.Name="搜索应用或窗口标题" ToolTip="输入应用名称或窗口标题，Ctrl+F 聚焦搜索"/>
          <TextBlock Text="搜索应用或窗口标题" Foreground="{StaticResource Muted}" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <Grid Grid.Row="1">
          <Border Background="White" CornerRadius="6" BorderBrush="#D4DBD1" BorderThickness="1">
            <ScrollViewer x:Name="WindowScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="WindowList"><ItemsControl.ItemTemplate><DataTemplate>
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="{Binding Target.Title}">
                  <StackPanel><TextBlock Text="{Binding Subtitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding DisplayTitle}" ToolTip="{Binding Target.Title}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="20"/>
                  </StackPanel>
                </CheckBox>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
          </Border>
          <TextBlock x:Name="EmptyLabel" Text="没有可选窗口，请打开普通窗口后刷新。" TextWrapping="Wrap" Margin="24"
                     VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
        </Grid>
      </Grid>
      <StackPanel x:Name="SettingsPane" Grid.Column="2">
        <Grid x:Name="SettingsFields">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
          <StackPanel x:Name="DisplayField" Margin="0,0,0,16">
            <TextBlock Text="排布到" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
            <ComboBox x:Name="DisplayPicker" MinHeight="32" Padding="8,4" SelectionChanged="DisplayChanged" AutomationProperties.Name="目标显示器"/>
          </StackPanel>
          <StackPanel x:Name="LayoutField" Grid.Row="1">
            <TextBlock Text="整组布局" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
            <ComboBox x:Name="LayoutPicker" MinHeight="32" Padding="8,4" SelectedIndex="0" SelectionChanged="LayoutChanged" AutomationProperties.Name="窗口布局">
              <ComboBoxItem Content="自动布局" Tag="{x:Static local:ArrangementKind.Automatic}" ToolTip="两三扇等宽并排，四扇起使用网格"/>
              <ComboBoxItem Content="等宽并排 · Alt+1" Tag="{x:Static local:ArrangementKind.Columns}"/>
              <ComboBoxItem Content="一主多辅 · Alt+2" Tag="{x:Static local:ArrangementKind.MainAndOthers}" ToolTip="1 号为主窗口"/>
              <ComboBoxItem Content="网格 · Alt+3" Tag="{x:Static local:ArrangementKind.Grid}"/>
            </ComboBox>
          </StackPanel>
        </Grid>
        <TextBlock Text="Alt+1 等宽 · Alt+2 主辅 · Alt+3 网格" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Expander x:Name="PreviewExpander" Header="布局预览" IsExpanded="True" Margin="0,12,0,0">
          <Border Background="#E4E9DF" CornerRadius="6" Padding="10" Margin="0,8,0,0">
            <Viewbox x:Name="PreviewView" Height="100" Stretch="Uniform"><Canvas x:Name="PreviewCanvas"/></Viewbox>
          </Border>
        </Expander>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="0,12,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ChosenCount" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0"/>
      <TextBlock x:Name="SelectionLabel" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
        <Button x:Name="RecentButton" Content="调整最近组" Click="RecentClick" Padding="10,6" MinHeight="32" IsEnabled="False"
                AutomationProperties.Name="调整最近组" ToolTip="载入上次成功排布的成员、顺序、目标和布局，不立即移动窗口"/>
        <Button x:Name="SwapButton" Content="交换左右" Click="SwapClick" Padding="10,6" MinHeight="32" Margin="8,0,0,0" AutomationProperties.Name="交换左右" ToolTip="Alt+S：交换左右或轮换顺序"/>
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="StatusView" Grid.Row="3" MaxHeight="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12"
                  ToolTip="{Binding Text, ElementName=StatusText}">
      <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20"/>
    </ScrollViewer>
    <StackPanel Grid.Row="4">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="ApplyButton" Content="排布所选窗口" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}"
                Click="ApplyClick" IsEnabled="False" IsDefault="True" AutomationProperties.Name="排布所选窗口"/>
        <Button x:Name="UndoButton" Grid.Column="1" Content="恢复上次排布" Margin="12,0,0,0" Click="UndoClick" IsEnabled="False" AutomationProperties.Name="恢复上次排布"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
          <Button Content="收起" Click="CloseClick" Padding="10,8" AutomationProperties.Name="收起" ToolTip="关闭按钮与 Esc 也会收起，快捷键仍可用"/>
          <Button Content="退出" Click="ExitClick" Padding="10,8" Margin="8,0,0,0" AutomationProperties.Name="退出" ToolTip="退出后快捷键停止，恢复记录清除"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="ShortcutText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</Window>
